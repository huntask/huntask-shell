DOTNET_EnableDiagnostics=1
ASPNETCORE_ENVIRONMENT=Development

Postgres__User=postgres
Postgres__Password=postgres
Postgres__Db=huntask

PgAdmin__DefaultEmail=admin@admin.com
PgAdmin__DefaultPassword=admin

RabbitMQ__Host=rabbitmq
RabbitMQ__User=admin
RabbitMQ__Password=admin

MassTransit__TempDataDirectory=/app/ms-message-data

ConnectionStrings__HuntaskDbConnection="Host=huntask-db;Port=5432;Database=huntask;Username=postgres;Password=postgres"

Jwt__Issuer=Huntask.Identity.Service
Jwt__Audience=Huntask
Jwt__Secret=0bc76cbe-76a3-4ce3-9138-62c08fb1b6b2
Jwt__ValidityHours=1

Cors__AllowOrigins="http://localhost:8080,http://localhost:8081,http://localhost:8082"

Serilog__MinimumLevel__Overrides__EntityFrameworkCore=Warning
Serilog__MinimumLevel__Overrides__Npgsql=Warning
Serilog__MinimumLevel__Overrides__Huntask.Identity.Service=Debug
Serilog__MinimumLevel__Overrides__Huntask.Tasks.Service=Debug

HuntaskPorts__IdentityServiceHttp=8081
HuntaskPorts__AssetsServiceHttp=8082

Assets__Folder=assets
Assets__DefaultContainer=other

FileSizes__MaxAssetFileSize=50
FileSizes__MessageDataThresholdSize=0
FileSizes__MaxAvatarFileSize=3
