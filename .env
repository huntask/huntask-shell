POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=todolist

PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

DOTNET_EnableDiagnostics=1
ASPNETCORE_ENVIRONMENT=Development

ConnectionStrings__TodoListDbConnection="Host=db;Port=5432;Database=todolist;Username=postgres;Password=postgres"

Jwt__Issuer=Identity.Service
Jwt__Audience=TodoList.Service
Jwt__Secret=0bc76cbe-76a3-4ce3-9138-62c08fb1b6b2
Jwt__ValidityHours=1

Serilog__MinimumLevel__Overrides__EntityFrameworkCore=Warning
Serilog__MinimumLevel__Overrides__Npgsql=Warning
Serilog__MinimumLevel__Overrides__Identity.Service=Debug
Serilog__MinimumLevel__Overrides__TodoList.Service=Debug

TODOLIST_HTTP_PORT=8080
IDENTITY_HTTP_PORT=8081

COMPOSE_PROFILES=tools,backend,frontend
