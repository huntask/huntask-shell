{
  "configurations": [
    {
      "name": "Attach to Huntask.Identity.Service to .NET in Docker",
      "type": "coreclr",
      "request": "attach",
      "processName": "dotnet",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": ["exec", "-i", "huntask-shell-huntask-identity-service-1"],
        "debuggerPath": "/vsdbg/vsdbg",
        "pipeCwd": "${workspaceFolder}",
        "quoteArgs": false
      },
      "sourceFileMap": {
        "/app/src/Huntask.Identity.Service": "${workspaceFolder}/src/Huntask.Identity.Service",
        "/app/src/Huntask.Identity.Service.Presentation": "${workspaceFolder}/src/Huntask.Identity.Service.Presentation",
        "/app/packages/Huntask.Common": "${workspaceFolder}/../../packages/Huntask.Common"
      }
    },
    {
      "name": "Huntask.Identity.Service .NET Launch (web)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-huntask-identity-service",
      "program": "${workspaceFolder}/src/Huntask.Identity.Service.Presentation/bin/Debug/net9.0/Huntask.Identity.Service.Presentation.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Huntask.Identity.Service.Presentation",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "uriFormat": "http://localhost:8081/swagger",
        "pattern": "Now listening on: http://\\[::\\]:8081"
      },
    }
  ],
}