FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /app

COPY packages/Huntask.Common/ ./packages/Huntask.Common/
COPY services/Huntask.Identity.Service/Huntask.Identity.Service.sln .
COPY services/Huntask.Identity.Service/src/Huntask.Identity.Service/*.csproj ./src/Huntask.Identity.Service/
COPY services/Huntask.Identity.Service/src/Huntask.Identity.Service.Presentation/*.csproj ./src/Huntask.Identity.Service.Presentation/
RUN dotnet restore Huntask.Identity.Service.sln -p:DockerBuild=true

COPY services/Huntask.Identity.Service/src/Huntask.Identity.Service/ ./src/Huntask.Identity.Service/
COPY services/Huntask.Identity.Service/src/Huntask.Identity.Service.Presentation/ ./src/Huntask.Identity.Service.Presentation/
RUN dotnet publish src/Huntask.Identity.Service.Presentation/Huntask.Identity.Service.Presentation.csproj -c Debug -o out -p:DockerBuild=true

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app
COPY --from=build /app/out ./

RUN apt-get update \
  && apt-get install -y unzip curl \
  && mkdir -p /vsdbg \
  && curl -sSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l /vsdbg

EXPOSE 8080
EXPOSE 5005

ENTRYPOINT ["dotnet", "Huntask.Identity.Service.Presentation.dll"]